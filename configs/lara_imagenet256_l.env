# Canonical environment for the anonymous LARA ImageNet 256x256 DiT-L run.
# Data assets are external to the submission archive. Override these paths in
# the shell for real training/evaluation; the defaults are anonymous local
# placeholders that make smoke-test commands self-contained.

: "${TRAIN_DATA_PATH:=${REPO_ROOT}/data/imagenet256/train_arrayrecords}"
: "${VAL_DATA_PATH:=${REPO_ROOT}/data/imagenet256/val_arrayrecords}"
: "${VAE_MODEL:=stabilityai/sd-vae-ft-ema}"
: "${INCEPTION_SCORE_WEIGHTS:=}"
: "${CKPT_DIR:=${REPO_ROOT}/checkpoints/lara_imagenet256}"
: "${WANDB_PROJECT:=lara-anonymous}"
